{
  "name": "@tingdahl/tsutils",
  "version": "0.1.0",
  "description": "Generic, product-agnostic TypeScript utilities for web applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tsutils-build-auth-config": "./bin/build-auth-config.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./proto": {
      "types": "./dist/proto/index.d.ts",
      "import": "./dist/proto/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./zip": {
      "types": "./dist/zip/index.d.ts",
      "import": "./dist/zip/index.js"
    },
    "./net": {
      "types": "./dist/net/index.d.ts",
      "import": "./dist/net/index.js"
    },
    "./html": {
      "types": "./dist/html/index.d.ts",
      "import": "./dist/html/index.js"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "import": "./dist/date/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./device": {
      "types": "./dist/device/index.d.ts",
      "import": "./dist/device/index.js"
    },
    "./terms": {
      "types": "./dist/terms/index.d.ts",
      "import": "./dist/terms/index.js"
    },
    "./legal": {
      "types": "./dist/terms/index.d.ts",
      "import": "./dist/terms/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepare": "npx -y -p typescript tsc"
  },
  "keywords": [
    "typescript",
    "utilities",
    "cache",
    "protobuf",
    "spa",
    "zip",
    "html",
    "date",
    "i18n",
    "auth",
    "device",
    "terms",
    "legal",
    "tools"
  ],
  "author": "Kristofer Tingdahl",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
